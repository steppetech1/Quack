# 1 = data from the backend, anything else = mocks (lib/mock)
NEXT_PUBLIC_QUACK_API=1
# Backend address for the /api proxy (next.config.ts)
QUACK_API_URL=http://localhost:8000
# The canvas WebSocket goes straight to the backend, not through the /api proxy (the proxy
# doesn't carry WS data through reliably). Without this the canvas silently never syncs.
NEXT_PUBLIC_QUACK_WS=ws://localhost:8000
