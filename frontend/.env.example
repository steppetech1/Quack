# =============================================================================
# Quack! Frontend Environment Configuration
# =============================================================================

# Источник данных для авторизации и профиля студента:
#   local  - аккаунты и данные хранятся локально в браузере (по умолчанию)
#   remote - работа с реальным бэкендом (FastAPI)
NEXT_PUBLIC_DATA_SOURCE=local

# Базовый URL API бэкенда (без завершающего слэша):
NEXT_PUBLIC_API_URL=http://localhost:8000

# Источник состояния движка Quack (шансы, темп, рекомендации):
#   local  - пересчет правил выполняется прямо в браузере
#   remote - состояние и сигналы пушатся бэкендом через SSE (GET /sse?topics=quack)
NEXT_PUBLIC_QUACK_SOURCE=local

# Подготовка: перекрывает NEXT_PUBLIC_DATA_SOURCE для экранов подготовки (local | remote).
# Не задан - наследует NEXT_PUBLIC_DATA_SOURCE.
# NEXT_PUBLIC_SRC_PREP=remote

# Google OAuth 2.0 Web Client ID (для боевой интеграции Google Identity Services):
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# Требования к бэкенду (FastAPI CORS & Cookies):
# 1. Access-Control-Allow-Origin: http://localhost:3000 (точный origin, НЕ '*')
# 2. Access-Control-Allow-Credentials: true
# 3. Cookie quack_token: HttpOnly; Path=/; SameSite=Lax (или SameSite=None; Secure)
# -----------------------------------------------------------------------------
