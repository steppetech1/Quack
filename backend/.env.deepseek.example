# DeepSeek, first-party API (https://platform.deepseek.com). Copy these lines over the LLM_* block of
# backend/.env, then put the key in LLM_API_KEY. Nothing else in the app changes.

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=

# Ids as in the docs at api-docs.deepseek.com. Check them against your account:
#   curl -s https://api.deepseek.com/models -H "Authorization: Bearer $LLM_API_KEY"
MODEL_CHAT=deepseek-flash
MODEL_BULK=deepseek-v4-pro

# The first-party API has no json_schema, only json_object: the schema travels in the prompt.
LLM_STRUCTURED_MODE=json_object
LLM_STRICT_SCHEMA=0

# Chat runs a tool loop, and in thinking mode the API demands reasoning_content back with every
# tool round — so the chat answers without thinking (which is also the fast path).
LLM_THINKING_CHAT=disabled
LLM_REASONING_CHAT=
# Background texts and reports have no tool loop: thinking pays off there.
LLM_THINKING_BULK=enabled
LLM_REASONING_BULK=high

LLM_TIMEOUT_CHAT_S=60
LLM_TIMEOUT_BULK_S=90

# DeepSeek allows far more than the Together-era defaults; these are our own ceilings.
LLM_RPM_CHAT=60
LLM_RPM_BULK=30
LLM_FORCE_DOWN=0
