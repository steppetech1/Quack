# Names only, no secret values (Д-§7). On the server this file is rendered by the deploy job into
# /srv/quack/.env (mode 600, owner `deploy`) from the GitHub Environment `production`.
# For a local stack copy it to `.env` next to compose.yaml and put TEST values in it.
#
# Each compose service receives only its own variables (Д-§7); this file is the union.

# --- Non-secret, per host --------------------------------------------------------------------
ENV=prod
LOG_LEVEL=INFO
API_DOMAIN=api.qvack.online
# Registry prefix of the two images, without the image name and tag: deploy.sh pulls
# ${QUACK_REGISTRY}/quack-backend:<sha> and ${QUACK_REGISTRY}/quack-compute:<sha>.
QUACK_REGISTRY=ghcr.io/<owner>
META_API_BASE_URL=https://api.meta.ai/v1
# D-C-133: sign-in returns to the frontend (Д-§2.1, Д-§3.1); the version of the terms text the
# consent screen shows (Т-§19.4) — a new text is a new version and asks for consent again.
AUTH_SUCCESS_REDIRECT_URL=https://app.qvack.online/
TERMS_VERSION=2026-11
# Name of the Contabo bucket of learner objects (Д-§8.4: quack-learners); the endpoint stays a
# secret below. Set it when the bucket is named differently.
S3_BUCKET_LEARNERS=quack-learners
# Price table of the models, JSON {model: {input, cached_input, output}} in dollars per 1M tokens
# (Т-§11.4). Values come from the owner; `api` and `workers` do not start in prod without it.
LLM_PRICES=
# D-B-211: the pool of dollars for the models; 0 turns the limit off (not secret, not required).
LLM_POOL_BUDGET_USD=0
# Where the pinned D3/Plotly/KaTeX of the visualizations are served (deploy/static/viz/, Caddy).
# Empty: https://<API_DOMAIN>/static/viz. Which libraries exist is `VIZ_LIBRARIES` in compose.yaml.
VIZ_STATIC_BASE_URL=
# R2 address of the deletions bucket (a config address, D-C-103): https://<account>.r2.cloudflarestorage.com
DELETIONS_S3_ENDPOINT=

# --- Secrets (values from the GitHub Environment `production`) -------------------------------
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
META_API_KEY=
# Tracing key (D-B-201); empty means tracing off.
LANGSMITH_API_KEY=
EMAIL_API_KEY=
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
DELETIONS_S3_ACCESS_KEY=
DELETIONS_S3_SECRET_KEY=
APP_DB_PASSWORD=
READER_DB_PASSWORD=
MIGRATOR_DB_PASSWORD=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
HEARTBEAT_BACKUP_URL=
ALERT_WEBHOOK_URL=
HEARTBEAT_ALERTS_URL=
# Chat body shape (Д-§14.3, chat not chosen): slack | discord | telegram. Telegram also needs the id.
ALERT_WEBHOOK_FORMAT=slack
ALERT_WEBHOOK_CHAT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Not secret: the PUBLIC key of age; the private half is never on the server (Д-§7) --------
BACKUP_AGE_PUBLIC_KEY=
