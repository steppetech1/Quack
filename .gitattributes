# line endings (nightrun)
* text=auto
*.sh text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
backend/quack/prompts/**/*.md text eol=lf

# binary files (nightrun)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.7z binary
*.gz binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.wav binary
*.ogg binary
*.mp4 binary
*.mov binary
*.dll binary
*.exe binary
*.fbx binary
*.blend binary
*.psd binary

# pinned third-party libraries are served byte for byte (deploy/static/viz/SHA256SUMS)
deploy/static/viz/** -text

