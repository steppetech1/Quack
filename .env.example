# Copy to `.env` in the repo root (next to compose.yaml) and fill in the values.
# compose.override.yaml is applied automatically by `docker compose` for local runs: it publishes
# the databases, the API and a local MinIO on 127.0.0.1 and wires sane local defaults, so this
# file only needs the handful of values below.

# Required: docker compose refuses to start without these two.
POSTGRES_PASSWORD=quack
NEO4J_PASSWORD=quacklocal123

# Required for the teacher to actually answer: a Meta Responses API key. Without it the API still
# starts, but every teacher turn fails (LLM_DEGRADED).
META_API_KEY=

# Everything else below is optional; compose.override.yaml already defaults S3/MinIO for local use.
LOG_LEVEL=INFO
LANGSMITH_API_KEY=
